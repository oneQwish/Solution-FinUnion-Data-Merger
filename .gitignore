# Whitelist: в репозиторий уходят только артефакты проектной работы

# 1. Игнорируем всё
/*

# 2. Корень: только README и сам .gitignore
!/.gitignore
!/README.md

# 3. Папки заданий: только md-файлы
!/Task1/
!/Task2/
!/Task3/
!/Task4/
/Task*/*
!/Task*/*.md

# 4. Диаграммы: только форматы, разрешённые заданием, и PNG-превью
!/Task*/diagrams/
/Task*/diagrams/*
!/Task*/diagrams/.gitkeep
!/Task*/diagrams/*.drawio
!/Task*/diagrams/*.png
!/Task*/diagrams/*.svg
!/Task*/diagrams/*.puml
!/Task*/diagrams/*.mmd
!/Task*/diagrams/*.md
!/Task*/diagrams/*.dsl

# 5. Мусор, даже если попал внутрь разрешённых папок
.DS_Store
.obsidian/
*.webarchive
*.bkp
*.drawio.bkp
.$*
~$*
*.tmp
*.swp
